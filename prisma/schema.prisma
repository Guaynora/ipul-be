generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  ADMIN
}

enum IncomeType {
  OFFERING
  TITHE
  SALE_OTHER
}

enum FundSource {
  TITHE
  NON_TITHE
}

enum DiscountStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("admin_users")
}

model Parishioner {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  baptized  Boolean
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt    @map("updated_at")
  incomes   Income[]

  @@map("parishioners")
}

model DiscountVersion {
  id            String         @id @default(uuid())
  version       Int
  status        DiscountStatus @default(DRAFT)
  effectiveFrom DateTime       @map("effective_from")
  rules         Json
  createdBy     String         @map("created_by")
  createdAt     DateTime       @default(now()) @map("created_at")
  activatedAt   DateTime?      @map("activated_at")
  incomes       Income[]

  @@unique([version])
  @@map("discount_versions")
}

model Income {
  id                String           @id @default(uuid())
  type              IncomeType
  amount            Decimal          @db.Decimal(14, 2)
  date              DateTime
  description       String?
  parishionerId     String?          @map("parishioner_id")
  discountVersionId String?          @map("discount_version_id")
  discountSnapshot  Json?            @map("discount_snapshot")
  createdBy         String           @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at")

  parishioner     Parishioner?     @relation(fields: [parishionerId], references: [id])
  discountVersion DiscountVersion? @relation(fields: [discountVersionId], references: [id])

  @@index([type, date])
  @@index([parishionerId])
  @@map("incomes")
}

model Expense {
  id          String     @id @default(uuid())
  description String
  amount      Decimal    @db.Decimal(14, 2)
  date        DateTime
  category    String
  fundSource  FundSource @map("fund_source")
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([fundSource, date])
  @@map("expenses")
}
